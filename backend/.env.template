# ── Database ───────────────────────────────────────────────────────────
# Pooled Neon connection URL (used at runtime)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Unpooled Neon URL (used by Alembic migrations and backend/scripts/*)
DATABASE_URL_DIRECT=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────────
# HMAC secret for JWT signing — REQUIRED, use a long random string
JWT_SECRET=change-me-to-a-random-secret
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── SMTP / email ───────────────────────────────────────────────────────
# Required only for sending emails (verification, notifications).
# For Gmail, use an App Password for SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ── Geocoding ──────────────────────────────────────────────────────────
# NOMINATIM_USER_AGENT=sambast-delivery/1.0

# ── Delivery costing (base + per-km) ───────────────────────────────────
# DELIVERY_BASE_FEE=50.0
# DELIVERY_PER_KM=15.0
# Warehouse origin for distance calculation (Quezon City default)
# WAREHOUSE_LAT=14.6760
# WAREHOUSE_LNG=121.0437
